# Public canonical origin of the site (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://nanakshahi.in

# Contact address shown on the Contact page and in the footer.
NEXT_PUBLIC_CONTACT_EMAIL=contact@nanakshahi.in

# Content source: "local" (Markdown files in /content) or "wordpress".
CONTENT_SOURCE=local

# Required only when CONTENT_SOURCE=wordpress, e.g. https://cms.nanakshahi.in/wp-json
WORDPRESS_API_URL=

# Optional endpoint returning today's Hukamnama as JSON (see README, "Hukamnama API").
# When empty, /hukamnama-today shows its informational state and never invents content.
HUKAMNAMA_API_URL=

# Google AdSense. Leave empty until the site is approved; no ad markup renders while empty.
NEXT_PUBLIC_ADSENSE_CLIENT=
